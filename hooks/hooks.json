{
  "modules": ["./compact.js"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Edit|Write|NotebookEdit|SendMessage|AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook PreToolUse",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook PermissionRequest",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook PermissionDenied", "timeout": 30 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook PostToolUse", "timeout": 30 }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^orchestra:",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook SubagentStop", "timeout": 30 }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook StopFailure", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook Stop", "timeout": 30 }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume|clear",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook SessionStart", "timeout": 30 }]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook SessionEnd" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/orchestra\" hook UserPromptSubmit", "timeout": 30 }]
      }
    ]
  }
}
